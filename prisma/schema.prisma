generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// UTILISATEURS & AGENCES
// ─────────────────────────────────────────────

enum UserRole {
  admin
  agency
  agent
  owner
  user
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(user)
  country       String    @default("SN") @db.VarChar(2)
  isVerified    Boolean   @default(false) @map("is_verified")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  twoFaSecret   String?   @map("two_fa_secret")
  twoFaEnabled  Boolean   @default(false) @map("two_fa_enabled")
  emailVerToken String?   @map("email_ver_token")
  resetPwToken  String?   @map("reset_pw_token")
  resetPwExpiry DateTime? @map("reset_pw_expiry")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  agency          Agency?         @relation("AgencyOwner")
  agencyMemberships AgencyMember[]
  properties      Property[]
  leads           Lead[]          @relation("LeadAssignee")
  leadActivities  LeadActivity[]
  tasks           Task[]
  favorites       Favorite[]
  alerts          Alert[]
  sentMessages    Message[]
  blogPosts       BlogPost[]
  estimations     Estimation[]
  referralsSent   Referral[]      @relation("ReferralSender")
  reviews         Review[]

  @@map("users")
}

enum AgencyPlan {
  free
  starter
  pro
  premium
  propafric_partner
}

model Agency {
  id              String      @id @default(cuid())
  userId          String      @unique @map("user_id")
  name            String
  slug            String      @unique
  description     String?
  logoUrl         String?     @map("logo_url")
  coverUrl        String?     @map("cover_url")
  phone           String?
  email           String?
  website         String?
  address         String?
  city            String?
  country         String      @default("SN") @db.VarChar(2)
  licenseNumber   String?     @map("license_number")
  isVerified      Boolean     @default(false) @map("is_verified")
  isPropafric       Boolean     @default(false) @map("is_propafric")
  propafrAgencyId   String?     @unique @map("propafric_agency_id")
  propafrApiKey     String?     @unique @map("propafric_api_key")
  propafrSecret     String?     @map("propafric_secret")
  propafrLastSync   DateTime?   @map("propafric_last_sync_at")
  propafrSyncStatus String?     @map("propafric_sync_status") @db.VarChar(50)
  plan            AgencyPlan  @default(free)
  planExpiresAt   DateTime?   @map("plan_expires_at")
  rating          Float?
  reviewsCount    Int         @default(0) @map("reviews_count")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user          User          @relation("AgencyOwner", fields: [userId], references: [id])
  members       AgencyMember[]
  properties    Property[]
  leads         Lead[]
  tasks         Task[]
  subscriptions Subscription[]
  referralsSent Referral[]    @relation("ReferralAgency")
  reviews       Review[]

  @@map("agencies")
}

enum AgencyMemberRole {
  admin
  agent
}

model AgencyMember {
  id        String           @id @default(cuid())
  agencyId  String           @map("agency_id")
  userId    String           @map("user_id")
  role      AgencyMemberRole @default(agent)
  createdAt DateTime         @default(now()) @map("created_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@map("agency_members")
}

// ─────────────────────────────────────────────
// BIENS IMMOBILIERS
// ─────────────────────────────────────────────

enum PropertyType {
  apartment
  villa
  house
  land
  office
  commercial
  building
  parking
  other
}

enum PropertyTransaction {
  sale
  rent
  rent_furnished
  new_construction
}

enum PropertyStatus {
  draft
  pending
  published
  sold
  rented
  archived
}

enum PropertyCondition {
  new
  old
  under_construction
}

model Property {
  id             String              @id @default(cuid())
  agencyId       String?             @map("agency_id")
  userId         String              @map("user_id")
  slug           String              @unique
  title          String
  description    String
  type           PropertyType
  transaction    PropertyTransaction
  country        String              @default("SN") @db.VarChar(2)
  city           String
  neighborhood   String?
  address        String?
  latitude       Float?
  longitude      Float?
  price          Decimal             @db.Decimal(14, 2)
  pricePeriod    String              @default("total") @map("price_period") @db.VarChar(20)
  currency       String              @default("XOF") @db.VarChar(3)
  isNegotiable   Boolean             @default(false) @map("is_negotiable")
  surface        Float?
  rooms          Int?
  bedrooms       Int?
  bathrooms      Int?
  floors         Int?
  floorNumber    Int?                @map("floor_number")
  parkingSpaces  Int?                @map("parking_spaces")
  amenities      Json                @default("[]")
  status         PropertyStatus      @default(pending)
  condition      PropertyCondition   @default(old)
  hasTitleDeed   Boolean             @default(false) @map("has_title_deed")
  isFeatured     Boolean             @default(false) @map("is_featured")
  isUrgent       Boolean             @default(false) @map("is_urgent")
  isSponsored    Boolean             @default(false) @map("is_sponsored")
  isNew          Boolean             @default(false) @map("is_new")
  isDiaspora     Boolean             @default(false) @map("is_diaspora")
  viewsCount     Int                 @default(0) @map("views_count")
  contactsCount  Int                 @default(0) @map("contacts_count")
  favoritesCount Int                 @default(0) @map("favorites_count")
  propafrExtId    String?             @unique @map("propafric_ext_id")
  metaTitle       String?             @map("meta_title")
  metaDescription String?             @map("meta_description")
  publishedAt     DateTime?           @map("published_at")
  expiresAt      DateTime?           @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  agency        Agency?       @relation(fields: [agencyId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  images        PropertyImage[]
  videos        PropertyVideo[]
  images360     PropertyImage360[]
  leads         Lead[]
  favorites     Favorite[]
  conversations Conversation[]
  boosts        Boost[]

  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  url        String
  alt        String?
  isCover    Boolean  @default(false) @map("is_cover")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_images")
}

model PropertyVideo {
  id           String   @id @default(cuid())
  propertyId   String   @map("property_id")
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  source       String   @default("upload") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_videos")
}

model PropertyImage360 {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  url        String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_images_360")
}

// ─────────────────────────────────────────────
// CRM — PROSPECTS
// ─────────────────────────────────────────────

enum LeadSource {
  immoafric
  whatsapp
  phone
  propafric
  referral
  other
}

enum LeadStage {
  new
  contacted
  visit_planned
  negotiation
  closed
  lost
}

model Lead {
  id                  String     @id @default(cuid())
  agencyId            String     @map("agency_id")
  propertyId          String?    @map("property_id")
  assignedTo          String?    @map("assigned_to")
  name                String
  phone               String?
  email               String?
  nationality         String?
  isDiaspora          Boolean    @default(false) @map("is_diaspora")
  desiredType         String?    @map("desired_type")
  desiredCity         String?    @map("desired_city")
  desiredNeighborhood String?    @map("desired_neighborhood")
  budgetMin           Decimal?   @map("budget_min") @db.Decimal(14, 2)
  budgetMax           Decimal?   @map("budget_max") @db.Decimal(14, 2)
  desiredRooms        Int?       @map("desired_rooms")
  timeline            String?    @db.VarChar(50)
  source              LeadSource @default(immoafric)
  stage               LeadStage  @default(new)
  notes               String?
  lostReason          String?    @map("lost_reason")
  closedAt            DateTime?  @map("closed_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  agency     Agency        @relation(fields: [agencyId], references: [id])
  property   Property?     @relation(fields: [propertyId], references: [id])
  assignee   User?         @relation("LeadAssignee", fields: [assignedTo], references: [id])
  activities LeadActivity[]
  tasks      Task[]
  reviews    Review[]

  @@map("leads")
}

enum LeadActivityType {
  note
  call
  email
  whatsapp
  visit
  stage_change
  assignment
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String           @map("lead_id")
  userId    String           @map("user_id")
  type      LeadActivityType
  content   String?
  oldStage  String?          @map("old_stage") @db.VarChar(50)
  newStage  String?          @map("new_stage") @db.VarChar(50)
  createdAt DateTime         @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("lead_activities")
}

enum TaskType {
  call
  email
  visit
  document
  other
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?   @map("lead_id")
  agencyId    String    @map("agency_id")
  assignedTo  String    @map("assigned_to")
  title       String
  description String?
  type        TaskType  @default(other)
  dueAt       DateTime  @map("due_at")
  isDone      Boolean   @default(false) @map("is_done")
  doneAt      DateTime? @map("done_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lead   Lead?  @relation(fields: [leadId], references: [id])
  agency Agency @relation(fields: [agencyId], references: [id])
  user   User   @relation(fields: [assignedTo], references: [id])

  @@map("tasks")
}

// ─────────────────────────────────────────────
// FAVORIS & ALERTES
// ─────────────────────────────────────────────

model Favorite {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("favorites")
}

enum AlertFrequency {
  instant
  daily
  weekly
}

enum AlertChannel {
  email
  whatsapp
  both
}

model Alert {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  name         String
  transaction  String?        @db.VarChar(30)
  type         String?        @db.VarChar(30)
  country      String?        @db.VarChar(2)
  city         String?
  priceMin     Decimal?       @map("price_min") @db.Decimal(14, 2)
  priceMax     Decimal?       @map("price_max") @db.Decimal(14, 2)
  surfaceMin   Float?         @map("surface_min")
  bedroomsMin  Int?           @map("bedrooms_min")
  frequency    AlertFrequency @default(daily)
  channel      AlertChannel   @default(email)
  phone        String?
  isActive     Boolean        @default(true) @map("is_active")
  lastSentAt   DateTime?      @map("last_sent_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

// ─────────────────────────────────────────────
// MESSAGERIE
// ─────────────────────────────────────────────

enum ConversationStatus {
  open
  closed
}

model Conversation {
  id         String             @id @default(cuid())
  propertyId String             @map("property_id")
  senderId   String             @map("sender_id")
  receiverId String             @map("receiver_id")
  status     ConversationStatus @default(open)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  property Property  @relation(fields: [propertyId], references: [id])
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  body           String
  attachmentUrl  String?  @map("attachment_url")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

// ─────────────────────────────────────────────
// BLOG
// ─────────────────────────────────────────────

enum BlogPostStatus {
  draft
  published
  archived
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?  @db.VarChar(7)
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id            String         @id @default(cuid())
  authorId      String         @map("author_id")
  categoryId    String         @map("category_id")
  title         String
  slug          String         @unique
  excerpt       String?
  content       String
  coverUrl      String?        @map("cover_url")
  tags          Json           @default("[]")
  countryTag    String?        @map("country_tag") @db.VarChar(2)
  isSponsored   Boolean        @default(false) @map("is_sponsored")
  sponsorName   String?        @map("sponsor_name")
  status        BlogPostStatus @default(draft)
  viewsCount    Int            @default(0) @map("views_count")
  readTime      Int            @default(5) @map("read_time")
  metaTitle     String?        @map("meta_title")
  metaDescription String?      @map("meta_description")
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  author   User         @relation(fields: [authorId], references: [id])
  category BlogCategory @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

// ─────────────────────────────────────────────
// PUBLICITÉS
// ─────────────────────────────────────────────

enum AdSlotPosition {
  hero
  sidebar
  between_results
  blog
  footer
}

model AdSlot {
  id           String         @id @default(cuid())
  name         String
  position     AdSlotPosition
  size         String         @db.VarChar(20)
  priceMonthly Decimal        @map("price_monthly") @db.Decimal(10, 2)
  description  String?
  createdAt    DateTime       @default(now()) @map("created_at")

  ads Ad[]

  @@map("ad_slots")
}

model Ad {
  id              String   @id @default(cuid())
  slotId          String   @map("slot_id")
  advertiserName  String   @map("advertiser_name")
  advertiserEmail String   @map("advertiser_email")
  imageUrl        String   @map("image_url")
  linkUrl         String   @map("link_url")
  altText         String?  @map("alt_text")
  countryTarget   String?  @map("country_target") @db.VarChar(2)
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  isActive        Boolean  @default(true) @map("is_active")
  clicksCount     Int      @default(0) @map("clicks_count")
  viewsCount      Int      @default(0) @map("views_count")
  amountPaid      Decimal  @map("amount_paid") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  slot AdSlot @relation(fields: [slotId], references: [id])

  @@map("ads")
}

// ─────────────────────────────────────────────
// ANNUAIRE DES PROFESSIONNELS
// ─────────────────────────────────────────────

enum ProfessionalPlan {
  free
  paid
}

model Professional {
  id          String           @id @default(cuid())
  userId      String?          @map("user_id")
  name        String
  category    String
  slug        String           @unique
  description String?
  logoUrl     String?          @map("logo_url")
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String?
  country     String           @default("SN") @db.VarChar(2)
  license     String?
  isVerified  Boolean          @default(false) @map("is_verified")
  isFeatured  Boolean          @default(false) @map("is_featured")
  plan        ProfessionalPlan @default(free)
  planExpiresAt DateTime?      @map("plan_expires_at")
  rating      Float?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("professionals")
}

// ─────────────────────────────────────────────
// ABONNEMENTS & PAIEMENTS
// ─────────────────────────────────────────────

enum PaymentMethod {
  wave
  orange_money
  mtn
  stripe
  paydunya
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

model Subscription {
  id            String             @id @default(cuid())
  agencyId      String             @map("agency_id")
  plan          AgencyPlan
  amount        Decimal            @db.Decimal(10, 2)
  currency      String             @default("XOF") @db.VarChar(3)
  paymentMethod PaymentMethod      @map("payment_method")
  paymentRef    String?            @map("payment_ref")
  isYearly      Boolean            @default(false) @map("is_yearly")
  startsAt      DateTime           @map("starts_at")
  expiresAt     DateTime           @map("expires_at")
  status        SubscriptionStatus @default(active)
  createdAt     DateTime           @default(now()) @map("created_at")

  agency Agency @relation(fields: [agencyId], references: [id])

  @@map("subscriptions")
}

enum BoostType {
  featured
  urgent
  top_city
  homepage
}

model Boost {
  id         String    @id @default(cuid())
  propertyId String    @map("property_id")
  type       BoostType
  amount     Decimal   @db.Decimal(10, 2)
  paymentRef String?   @map("payment_ref")
  startsAt   DateTime  @map("starts_at")
  endsAt     DateTime  @map("ends_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@map("boosts")
}

// ─────────────────────────────────────────────
// ESTIMATION
// ─────────────────────────────────────────────

model Estimation {
  id                String   @id @default(cuid())
  userId            String?  @map("user_id")
  type              String
  city              String
  neighborhood      String?
  surface           Float
  rooms             Int?
  bedrooms          Int?
  amenities         Json     @default("[]")
  estimatedPriceMin Decimal  @map("estimated_price_min") @db.Decimal(14, 2)
  estimatedPriceMax Decimal  @map("estimated_price_max") @db.Decimal(14, 2)
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("estimations")
}

// ─────────────────────────────────────────────
// PARRAINAGE & AVIS
// ─────────────────────────────────────────────

model Referral {
  id               String    @id @default(cuid())
  referrerId       String    @map("referrer_id")
  referredAgencyId String    @map("referred_agency_id")
  bonusAppliedAt   DateTime? @map("bonus_applied_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  referrer       User   @relation("ReferralSender", fields: [referrerId], references: [id])
  referredAgency Agency @relation("ReferralAgency", fields: [referredAgencyId], references: [id])

  @@map("referrals")
}

model Review {
  id        String   @id @default(cuid())
  agencyId  String   @map("agency_id")
  userId    String   @map("user_id")
  leadId    String   @map("lead_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  agency Agency @relation(fields: [agencyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  lead   Lead   @relation(fields: [leadId], references: [id])

  @@unique([userId, agencyId])
  @@map("reviews")
}
