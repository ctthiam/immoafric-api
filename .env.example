# Base de données (Railway PostgreSQL — copier depuis l'onglet Variables du service PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/immoafric

# Redis (Railway Redis — copier depuis l'onglet Variables du service Redis)
REDIS_URL=redis://default:password@host:6379

# JWT
JWT_SECRET=change_me_min_32_chars_random_string
JWT_REFRESH_SECRET=change_me_min_32_chars_random_string_refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://immoafric-app.vercel.app

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=immoafric-media
R2_PUBLIC_URL=https://media.immoafric.com

# Resend (emails transactionnels)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@immoafric.com
RESEND_FROM_NAME=ImmoAfric

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# WhatsApp Business API
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# PayDunya (paiements SN/CI)
PAYDUNYA_MASTER_KEY=your_paydunya_master_key
PAYDUNYA_PRIVATE_KEY=your_paydunya_private_key
PAYDUNYA_TOKEN=your_paydunya_token
PAYDUNYA_MODE=live

# Stripe (paiements diaspora)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Synchro PropAfric
PROPAFRIC_WEBHOOK_URL=https://immoafric-api.up.railway.app/api/propafric/sync
